#
# Install as /etc/systemd/system/rekor-publish.timer, then
# `systemctl enable --now rekor-publish.timer`.

[Unit]
Description=Publish the rekor log to Azure Blob Storage periodically

[Timer]
OnBootSec=30s
# Measured from the end of the previous run, so a slow publish backs off on its
# own instead of queueing up behind itself.
#
# This should be at or below the server's --checkpoint-interval: it bounds how
# stale the published log can be, and staleness is the only thing it affects.
# Correctness comes from the ordering inside rekor-publish.sh, not from this.
OnUnitInactiveSec=30s
AccuracySec=1s

[Install]
WantedBy=timers.target
