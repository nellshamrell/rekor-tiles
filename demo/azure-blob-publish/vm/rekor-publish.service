# One publish cycle. Install as /etc/systemd/system/rekor-publish.service.
# Triggered by rekor-publish.timer, not enabled directly.

[Unit]
Description=Publish the rekor log to Azure Blob Storage
Requires=var-lib-rekor.mount
After=var-lib-rekor.mount network-online.target

[Service]
# Type=oneshot plus a timer means cycles cannot overlap: systemd will not start
# another while this one is running. Two concurrent publishers could interleave
# their phases and put a checkpoint on the read path ahead of its tiles, which
# is the one failure this design exists to prevent.
Type=oneshot
User=rekor
Group=rekor

Environment=REKOR_STORAGE_DIR=/var/lib/rekor/log
Environment=REKOR_STORAGE_ACCOUNT=STORAGE_ACCOUNT_NAME
# The Azure CLI needs a writable home for its token cache and config.
Environment=AZURE_CONFIG_DIR=/var/lib/rekor/.azure

# Authenticate as the VM's system-assigned managed identity, which holds
# Storage Blob Data Contributor on the account. No credential on disk. The
# token is cached, so this is a no-op on most cycles.
ExecStartPre=/usr/bin/az login --identity --output none
ExecStart=/usr/local/bin/rekor-publish.sh

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/rekor
